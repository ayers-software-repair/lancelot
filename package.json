{
  "name": "@ayerselectronics/lancelot",
  "version": "0.3.2",
  "mcpName": "io.github.ayers-software-repair/lancelot",
  "description": "An MCP server for search and retrieval over a local LanceDB database",
  "type": "module",
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "bin": {
    "lancelot": "./dist/bin/lancelot.js",
    "lancelot-init": "./dist/bin/lancelot-init.js",
    "lancelot-index": "./dist/bin/lancelot-index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepublishOnly": "npm run check",
    "pretest": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lancedb",
    "vector-search",
    "rag",
    "embeddings"
  ],
  "author": "Zachariah Ayers",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayers-software-repair/lancelot.git"
  },
  "bugs": {
    "url": "https://github.com/ayers-software-repair/lancelot/issues"
  },
  "homepage": "https://github.com/ayers-software-repair/lancelot#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@lancedb/lancedb": "0.21.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "conf": "14.0.0",
    "inquirer": "12.9.3",
    "keytar": "7.9.0",
    "openai": "6.49.0",
    "winston": "3.17.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/node": "24.3.0",
    "eslint": "9.33.0",
    "prettier": "3.6.2",
    "tsup": "8.5.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "3.2.4"
  }
}
